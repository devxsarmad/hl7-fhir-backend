generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id            String      @id @default(uuid())
  patientId     String      @unique
  firstName     String
  lastName      String
  middleName    String?
  dateOfBirth   String
  gender        String
  street        String?
  city          String?
  state         String?
  zipCode       String?
  phoneNumber   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  orders        Order[]
}

model Order {
  id                  String      @id @default(uuid())
  orderControl        String
  placerOrderNumber   String      @unique
  fillerOrderNumber   String?
  orderDateTime       String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  patientId           String
  patient             Patient     @relation(fields: [patientId], references: [id])
  
  observations        Observation[]
}

model Observation {
  id                      String   @id @default(uuid())
  setId                   String
  observationCode         String
  observationText         String
  observationCodingSystem String
  observationDateTime     String
  orderingProviderId      String?
  orderingProviderLastName String?
  orderingProviderFirstName String?
  // fields for OBX data:
  valueType               String?   // NM, ST, TX, etc.
  value                   String?   // The actual result value
  units                   String?   // Units of measurement
  referenceRangeLow       String?   // Lower bound
  referenceRangeHigh      String?   // Upper bound
  abnormalFlags           String?   // N, H, L, etc.
  resultStatus            String?   // F, P, C (Final, Preliminary, Corrected)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  orderId                 String
  order                   Order    @relation(fields: [orderId], references: [id])
  
  @@unique([orderId, setId])
}